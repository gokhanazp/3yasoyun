{
  "expo": {
    "name": "3 Yaş Oyunları",
    "slug": "3yasoyun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "description": "3 yaş çocuklar için eğitici ve eğlenceli oyunlar. Renkler, sayılar, şekiller, hayvanlar ve daha fazlasını öğrenin!",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#667eea"
    },
    "privacy": "public",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yasoyun.egitici",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Bu uygulama ses tanıma için mikrofon kullanmaz, sadece ses çıkışı yapar.",
        "NSSpeechRecognitionUsageDescription": "Bu uygulama konuşma tanıma kullanmaz."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.yasoyun.egitici",
      "permissions": [
        "INTERNET"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id-here"
      }
    }
  }
}
